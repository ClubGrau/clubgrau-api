### Create employee
# Requer role ADMIN ou MANAGER (requireRoles). EMPLOYEE → 403.
# status no body é ignorado — o domínio força ACTIVE.
# passwordConfirmation continua obrigatório (frontend pode repetir password).
POST http://localhost:3003/api/employee
Content-Type: application/json
Authorization: Bearer {{employeeToken}}

{
  "name": " Usuario do Grau ",
  "email": "usuariodo.grau@example.com",
  "role": "ADMIN",
  "phone": "+351 912 345 678",
  "nif": "123456789",
  "password": "P@ssword123",
  "passwordConfirmation": "P@ssword123",
  "status": "ACTIVE",
  "username": "usuariograu",
  "gender": "male",
  "address": "Rua do Grau, 10",
  "languages": "pt,en",
  "emergencyContact": "+351 910 000 000",
  "employmentId": "HR-001",
  "jobTitle": "Barber"
}

### List employees
# Requer role ADMIN ou MANAGER (requireRoles). EMPLOYEE → 403.
GET http://localhost:3003/api/employees
Authorization: Bearer {{token}}

### List employees (pagination)
GET http://localhost:3003/api/employees?page=1&limit=20
Authorization: Bearer {{token}}

### List employees (filters + pagination)
GET http://localhost:3003/api/employees?status=ACTIVE&role=EMPLOYEE&search=grau&page=2&limit=10
Authorization: Bearer {{token}}

### List employees (inactive)
GET http://localhost:3003/api/employees?status=INVALID&page=1&limit=10
Authorization: Bearer {{token}}
# GET .../employees?status=REMOVED → 400 Invalid param status

### List employees (vacation)
GET http://localhost:3003/api/employees?status=VACATION&page=1&limit=10
Authorization: Bearer {{token}}

### Update employee status
# Actor vem do Bearer token (adaptRoute stampa actorId). Não enviar actorId no body.
POST http://localhost:3003/api/employee/update-status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "75a8421596c6c09cff9425d6",
  "status": "INACTIVE"
}

### Update main employee data (partial patch)
# Target vem do path param :id. Actor vem do Bearer token (adaptRoute stampa actorId).
# Não enviar id ou actorId no body. Presença esparsa: só campos presentes são alterados.
# status/password neste body → 400 (usar POST /employee/update-status para status).
# username "" ou null → clear (username null). phone/name/email em branco → 400.
PATCH http://localhost:3003/api/employee/70825d5a48dd674234be304d/main-data
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "MARQUIN HAIRSTYLE",
  "email": "marquin@hairstyledograu.com"
}

### Update main employee data (clear username)
PATCH http://localhost:3003/api/employee/75a8421596c6c09cff9425d6/main-data
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": null
}

### Update main employee data (blank username clears)
PATCH http://localhost:3003/api/employee/75a8421596c6c09cff9425d6/main-data
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": ""
}

### Update main employee data (blank phone → 400)
PATCH http://localhost:3003/api/employee/75a8421596c6c09cff9425d6/main-data
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "phone": ""
}

### Update main employee data (empty body → 400)
PATCH http://localhost:3003/api/employee/75a8421596c6c09cff9425d6/main-data
Content-Type: application/json
Authorization: Bearer {{token}}

{}

### Update main employee data (status in body → 400)
PATCH http://localhost:3003/api/employee/75a8421596c6c09cff9425d6/main-data
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "INACTIVE"
}

### Update main employee data (EMPLOYEE token → 403)
PATCH http://localhost:3003/api/employee/75a8421596c6c09cff9425d6/main-data
Content-Type: application/json
Authorization: Bearer {{employeeToken}}

{
  "name": "João Silva"
}

### Remove employee (anonymize)
# Actor vem do Bearer token (adaptRoute stampa actorId). Não enviar actorId no body.
# password é a senha do Actor (step-up), não a do Target.
POST http://localhost:3003/api/employee/remove
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "75a8421596c6c09cff9425d6",
  "password": "P@ssword123"
}
